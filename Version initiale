if ($LASTEXITCODE -ne 0) { Write-Host "Echec de la fabrication de l'executable." -ForegroundColor Red; exit 1 }

# --- 5. Copier l'executable a la racine du projet ---
Copy-Item ".\dist\RepeteurCW.exe" ".\RepeteurCW.exe" -Force

